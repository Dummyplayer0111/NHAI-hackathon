APP_ENV=production
ADMIN_API_KEY=replace-with-strong-random-admin-key
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=attendance_db
ALLOWED_HOSTS=api.example.gov.in
ALLOWED_ORIGINS=https://admin.example.gov.in
FACE_MATCH_THRESHOLD=0.75
LIVENESS_SCORE_THRESHOLD=0.70
FACE_QUALITY_SCORE_THRESHOLD=0.65
MAX_LOCATION_ACCURACY_METERS=100
MAX_OFFLINE_EVENT_AGE_HOURS=72
RATE_LIMIT_REQUESTS_PER_MINUTE=120
