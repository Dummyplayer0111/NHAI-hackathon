{
  "name": "nhai-offline-attendance-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:liveness": "tsc -p tsconfig.liveness.json && node .tmp-tests/scripts/liveness-check.js",
    "test:capture": "tsc -p tsconfig.liveness.json && node .tmp-tests/scripts/capture-check.js",
    "test:native-prebuild": "tsc -p tsconfig.liveness.json && node .tmp-tests/scripts/native-prebuild-check.js",
    "benchmark:liveness": "tsc -p tsconfig.liveness.json && node .tmp-tests/scripts/liveness-benchmark.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^1.7.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "^56.0.8",
    "expo-asset": "^56.0.15",
    "expo-camera": "~56.0.7",
    "expo-constants": "^56.0.16",
    "expo-file-system": "~56.0.7",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
